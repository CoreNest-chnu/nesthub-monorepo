{
  "name": "nesthub-monorepo",
  "private": true,
  "scripts": {
    "start:dev": "turbo run start:dev",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check . --write",
    "db:start:docker": "bash ./bin/db-start-docker.sh",
    "db:start:docker:compose": "docker compose up -d db pgadmin"
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "class-validator": "^0.15.1",
    "lodash": "^4.18.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/lodash": "^4.17.24",
    "@types/passport-jwt": "^4.0.1",
    "bun": "^1.3.13",
    "install": "^0.13.0",
    "prisma": "^7.5.0",
    "turbo": "^2.8.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
