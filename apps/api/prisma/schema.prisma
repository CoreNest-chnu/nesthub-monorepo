
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
  other
}

enum Role {
  admin
  user
}

model User {
    id String @id @default(cuid())

    email String @unique

    firstName String
    lastName  String

    password  String

    phone     String?
    avatar    String?
    birthDate DateTime?
    gender    Gender?   @default(other)
    role      Role      @default(user)

    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}