
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "commonjs"
}

generator ids {
  provider = "node ../../packages/prisma-generator-ids/index.js"
  output   = "../generated/prisma/types.ts"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
  other
}

enum Role {
  admin
  user
}

model User {
    id String @id @default(cuid())

    email String @unique

    firstName String
    lastName  String

    password  String

    phone     String?
    avatar    String?
    birthDate DateTime?
    gender    Gender?   @default(other)
    role      Role      @default(user)

    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}

model Category {
  id String @id @default(cuid())

  name String @unique

  products  Product[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id String @id @default(cuid())

  name        String
  description String?

  price    Decimal  @db.Decimal(10, 2)
  imageUrl String?
  stock    Int      @default(0)

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

