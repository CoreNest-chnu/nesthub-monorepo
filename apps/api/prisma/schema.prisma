
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}


model User {
    id String @id @default(cuid())
    email String @unique
    password String
    firstName String
    lastName String
    phone String
    avatar String
    birthDate DateTime
    gender String
    role String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}