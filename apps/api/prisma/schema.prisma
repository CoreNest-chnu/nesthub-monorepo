
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  ADMIN
  USER
}

model User {
    id String @id @default(cuid())

    email String @unique

    firstName String
    lastName  String

    password  String

    phone     String?
    avatar    String?
    birthDate DateTime?
    gender    Gender?
    role      Role

    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}