{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "stream",
  "tasks": {
    "ci:build:production": {
      "dependsOn": ["^build"]
    },
    "ci:build:staging": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "prisma/**",
        "jest.config.ts",
        "jest.setup.ts",
        "tsconfig*.json",
        ".env"
      ],
      "passThroughEnv": ["TEST_DATABASE_URL", "NODE_OPTIONS"]
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    },
    "graphql:generate": {},
    "db:start:docker": {},
    "db:dump:start:docker": {}
  }
}
